# Safe-Direction Agent 환경 변수 템플릿
# 테스트 단계: Google Gemini API 연동 시
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# 사내 폐쇄망 배포 단계: NPO-MAXIS / vLLM 연동 시
# LLM_PROVIDER=internal
# LLM_BASE_URL=http://your-internal-llm-host:8000/v1
# LLM_API_KEY=your-internal-token
# LLM_MODEL_NAME=GLM-5.3-Flash
